{
  "name": "multi-harness-terminal-editor",
  "displayName": "%displayName%",
  "description": "Open AI coding-agent CLIs (Claude Code, Codex, OpenCode, Pi, Oh My Pi, Gemini CLI, Copilot CLI, Cursor Agent, Aider, Crush, Qwen Code, Goose, Prime Agent, Antigravity CLI, DeepSeek Harness) in native editor-area terminal tabs.",
  "version": "0.8.21",
  "license": "MIT",
  "publisher": "yasir-erkam-ozdemir",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.67.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yasir-erkam/Multi-Harness-Terminal-Editor.git"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "ai",
    "agent",
    "claude code",
    "codex",
    "opencode",
    "gemini cli",
    "copilot cli",
    "cursor agent",
    "aider",
    "crush",
    "qwen code",
    "goose",
    "oh my pi",
    "pi agent",
    "prime agent",
    "prime-agent",
    "antigravity",
    "agy",
    "deepseek harness",
    "deepseek",
    "dsh"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:multiHarness.sessions",
    "onCommand:multiHarness.focusSession",
    "onCommand:multiHarness.closeSession",
    "onCommand:multiHarness.addFavorite",
    "onCommand:multiHarness.removeFavorite",
    "onCommand:multiHarness.openSettings",
    "onView:multiHarness.agents",
    "onCommand:multiHarness.openClaudeCode",
    "onCommand:multiHarness.openCodex",
    "onCommand:multiHarness.openOpenCode",
    "onCommand:multiHarness.openPi",
    "onCommand:multiHarness.openOhMyPi",
    "onCommand:multiHarness.openGemini",
    "onCommand:multiHarness.openCopilot",
    "onCommand:multiHarness.openCursorAgent",
    "onCommand:multiHarness.openAider",
    "onCommand:multiHarness.openCrush",
    "onCommand:multiHarness.openQwen",
    "onCommand:multiHarness.openGoose",
    "onCommand:multiHarness.openAgentPicker",
    "onTerminalProfile:multiHarness.claudeCode",
    "onTerminalProfile:multiHarness.codex",
    "onTerminalProfile:multiHarness.openCode",
    "onTerminalProfile:multiHarness.pi",
    "onTerminalProfile:multiHarness.ohMyPi",
    "onTerminalProfile:multiHarness.gemini",
    "onTerminalProfile:multiHarness.copilot",
    "onTerminalProfile:multiHarness.cursorAgent",
    "onTerminalProfile:multiHarness.aider",
    "onTerminalProfile:multiHarness.crush",
    "onTerminalProfile:multiHarness.qwen",
    "onTerminalProfile:multiHarness.goose",
    "onCommand:multiHarness.openPrimeAgent",
    "onTerminalProfile:multiHarness.primeAgent",
    "onView:multiHarness.savedSessions",
    "onCommand:multiHarness.resumeSession",
    "onCommand:multiHarness.refreshSessions",
    "onCommand:multiHarness.toggleSessionLocationScope",
    "onCommand:multiHarness.selectSessionAgent",
    "onView:multiHarness.cards",
    "onCommand:multiHarness.toggleSidebarLayout",
    "onCommand:multiHarness.toggleSessionSelectionMode",
    "onCommand:multiHarness.cancelSessionSelection",
    "onCommand:multiHarness.toggleSessionSelection",
    "onCommand:multiHarness.selectAllSessions",
    "onCommand:multiHarness.deleteSession",
    "onCommand:multiHarness.deleteSelectedSessions",
    "onCommand:multiHarness.openAntigravity",
    "onTerminalProfile:multiHarness.antigravity",
    "onCommand:multiHarness.openDeepseek",
    "onTerminalProfile:multiHarness.deepseek"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multiHarness",
          "title": "%viewContainer.title%",
          "icon": "media/activity-bar-yeo.svg"
        }
      ]
    },
    "views": {
      "multiHarness": [
        {
          "id": "multiHarness.agents",
          "name": "%view.agents.name%",
          "when": "config.multiHarness.sidebarLayout != cards"
        },
        {
          "id": "multiHarness.savedSessions",
          "name": "%view.savedSessions.name%",
          "when": "config.multiHarness.sidebarLayout != cards"
        },
        {
          "id": "multiHarness.sessions",
          "name": "%view.sessions.name%",
          "when": "config.multiHarness.sidebarLayout != cards"
        },
        {
          "id": "multiHarness.cards",
          "type": "webview",
          "name": "%view.cards.name%",
          "when": "config.multiHarness.sidebarLayout == cards"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "multiHarness.sessions",
        "contents": "%view.sessions.welcome%"
      },
      {
        "view": "multiHarness.savedSessions",
        "contents": "%view.savedSessions.welcome%",
        "when": "multiHarness.hasSelectedSessionAgent"
      },
      {
        "view": "multiHarness.savedSessions",
        "contents": "%view.savedSessions.selectAgent%",
        "when": "!multiHarness.hasSelectedSessionAgent"
      }
    ],
    "commands": [
      {
        "command": "multiHarness.focusSession",
        "title": "%command.focusSession.title%",
        "category": "%category%"
      },
      {
        "command": "multiHarness.closeSession",
        "title": "%command.closeSession.title%",
        "category": "%category%",
        "icon": "$(close)"
      },
      {
        "command": "multiHarness.addFavorite",
        "title": "%command.addFavorite.title%",
        "category": "%category%",
        "icon": "$(star-empty)"
      },
      {
        "command": "multiHarness.removeFavorite",
        "title": "%command.removeFavorite.title%",
        "category": "%category%",
        "icon": "$(star-full)"
      },
      {
        "command": "multiHarness.openSettings",
        "title": "%command.openSettings.title%",
        "category": "%category%",
        "icon": "$(gear)"
      },
      {
        "command": "multiHarness.openDeepseek",
        "title": "%command.openDeepseek.title%",
        "category": "%category%",
        "icon": {
          "light": "media/deepseek-light.svg",
          "dark": "media/deepseek-dark.svg"
        }
      },
      {
        "command": "multiHarness.openOpenCode",
        "title": "%command.openOpenCode.title%",
        "category": "%category%",
        "icon": {
          "light": "media/openCode-light.svg",
          "dark": "media/openCode-dark.svg"
        }
      },
      {
        "command": "multiHarness.openClaudeCode",
        "title": "%command.openClaudeCode.title%",
        "category": "%category%",
        "icon": {
          "light": "media/claudeCode-light.svg",
          "dark": "media/claudeCode-dark.svg"
        }
      },
      {
        "command": "multiHarness.openCodex",
        "title": "%command.openCodex.title%",
        "category": "%category%",
        "icon": {
          "light": "media/codex-light.svg",
          "dark": "media/codex-dark.svg"
        }
      },
      {
        "command": "multiHarness.openPi",
        "title": "%command.openPi.title%",
        "category": "%category%",
        "icon": {
          "light": "media/pi-light.svg",
          "dark": "media/pi-dark.svg"
        }
      },
      {
        "command": "multiHarness.openGemini",
        "title": "%command.openGemini.title%",
        "category": "%category%",
        "icon": {
          "light": "media/gemini-light.svg",
          "dark": "media/gemini-dark.svg"
        }
      },
      {
        "command": "multiHarness.openGoose",
        "title": "%command.openGoose.title%",
        "category": "%category%",
        "icon": {
          "light": "media/goose-light.svg",
          "dark": "media/goose-dark.svg"
        }
      },
      {
        "command": "multiHarness.openAider",
        "title": "%command.openAider.title%",
        "category": "%category%",
        "icon": {
          "light": "media/aider-light.svg",
          "dark": "media/aider-dark.svg"
        }
      },
      {
        "command": "multiHarness.openOhMyPi",
        "title": "%command.openOhMyPi.title%",
        "category": "%category%",
        "icon": {
          "light": "media/ohMyPi-light.svg",
          "dark": "media/ohMyPi-dark.svg"
        }
      },
      {
        "command": "multiHarness.openCrush",
        "title": "%command.openCrush.title%",
        "category": "%category%",
        "icon": {
          "light": "media/crush-light.svg",
          "dark": "media/crush-dark.svg"
        }
      },
      {
        "command": "multiHarness.openQwen",
        "title": "%command.openQwen.title%",
        "category": "%category%",
        "icon": {
          "light": "media/qwen-light.svg",
          "dark": "media/qwen-dark.svg"
        }
      },
      {
        "command": "multiHarness.openPrimeAgent",
        "title": "%command.openPrimeAgent.title%",
        "category": "%category%",
        "icon": {
          "light": "media/primeAgent-light.svg",
          "dark": "media/primeAgent-dark.svg"
        }
      },
      {
        "command": "multiHarness.openAgentPicker",
        "title": "%command.openAgentPicker.title%",
        "category": "%category%"
      },
      {
        "command": "multiHarness.openCopilot",
        "title": "%command.openCopilot.title%",
        "category": "%category%",
        "icon": {
          "light": "media/copilot-light.svg",
          "dark": "media/copilot-dark.svg"
        }
      },
      {
        "command": "multiHarness.resumeSession",
        "title": "%command.resumeSession.title%",
        "category": "%category%"
      },
      {
        "command": "multiHarness.refreshSessions",
        "title": "%command.refreshSessions.title%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "multiHarness.toggleSessionLocationScope",
        "title": "%command.toggleSessionLocationScope.title%",
        "category": "%category%",
        "icon": "$(globe)",
        "enablement": "!multiHarness.deletingSessions"
      },
      {
        "command": "multiHarness.selectSessionAgent",
        "title": "%command.selectSessionAgent.title%",
        "category": "%category%",
        "icon": "$(filter)"
      },
      {
        "command": "multiHarness.toggleSidebarLayout",
        "title": "%command.toggleSidebarLayout.title%",
        "category": "%category%",
        "icon": "$(layout)"
      },
      {
        "command": "multiHarness.toggleSessionSelectionMode",
        "title": "%command.toggleSessionSelectionMode.title%",
        "category": "%category%",
        "icon": "$(checklist)",
        "enablement": "!multiHarness.deletingSessions"
      },
      {
        "command": "multiHarness.cancelSessionSelection",
        "title": "%command.cancelSessionSelection.title%",
        "category": "%category%",
        "icon": "$(close)",
        "enablement": "!multiHarness.deletingSessions"
      },
      {
        "command": "multiHarness.toggleSessionSelection",
        "title": "%command.toggleSessionSelection.title%",
        "category": "%category%",
        "icon": "$(check)",
        "enablement": "!multiHarness.deletingSessions"
      },
      {
        "command": "multiHarness.selectAllSessions",
        "title": "%command.selectAllSessions.title%",
        "category": "%category%",
        "icon": "$(check-all)",
        "enablement": "!multiHarness.deletingSessions"
      },
      {
        "command": "multiHarness.deleteSession",
        "title": "%command.deleteSession.title%",
        "category": "%category%",
        "icon": "$(trash)",
        "enablement": "!multiHarness.deletingSessions"
      },
      {
        "command": "multiHarness.deleteSelectedSessions",
        "title": "%command.deleteSelectedSessions.title%",
        "category": "%category%",
        "icon": "$(trash)",
        "enablement": "multiHarness.hasSelectedSessions && !multiHarness.deletingSessions"
      },
      {
        "command": "multiHarness.openAntigravity",
        "title": "%command.openAntigravity.title%",
        "category": "%category%",
        "icon": {
          "light": "media/antigravity-light.svg",
          "dark": "media/antigravity-dark.svg"
        }
      },
      {
        "command": "multiHarness.openCursorAgent",
        "title": "%command.openCursorAgent.title%",
        "category": "%category%",
        "icon": {
          "light": "media/cursorAgent-light.svg",
          "dark": "media/cursorAgent-dark.svg"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "multiHarness.focusSession",
          "when": "false"
        },
        {
          "command": "multiHarness.closeSession",
          "when": "false"
        },
        {
          "command": "multiHarness.addFavorite",
          "when": "false"
        },
        {
          "command": "multiHarness.removeFavorite",
          "when": "false"
        },
        {
          "command": "multiHarness.resumeSession",
          "when": "false"
        },
        {
          "command": "multiHarness.toggleSessionSelectionMode",
          "when": "false"
        },
        {
          "command": "multiHarness.cancelSessionSelection",
          "when": "false"
        },
        {
          "command": "multiHarness.toggleSessionSelection",
          "when": "false"
        },
        {
          "command": "multiHarness.selectAllSessions",
          "when": "false"
        },
        {
          "command": "multiHarness.deleteSession",
          "when": "false"
        },
        {
          "command": "multiHarness.deleteSelectedSessions",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "multiHarness.addFavorite",
          "when": "view == multiHarness.agents && viewItem == agent",
          "group": "inline"
        },
        {
          "command": "multiHarness.removeFavorite",
          "when": "view == multiHarness.agents && viewItem == favoriteAgent",
          "group": "inline"
        },
        {
          "command": "multiHarness.deleteSession",
          "when": "view == multiHarness.savedSessions && viewItem == savedSession && !multiHarness.deletingSessions",
          "group": "inline"
        },
        {
          "command": "multiHarness.deleteSession",
          "when": "view == multiHarness.savedSessions && viewItem == savedSession && !multiHarness.deletingSessions",
          "group": "session"
        },
        {
          "command": "multiHarness.closeSession",
          "when": "view == multiHarness.sessions && viewItem == openTerminal",
          "group": "inline"
        },
        {
          "command": "multiHarness.closeSession",
          "when": "view == multiHarness.sessions && viewItem == openTerminal",
          "group": "terminal"
        }
      ],
      "view/title": [
        {
          "command": "multiHarness.toggleSessionLocationScope",
          "when": "view == multiHarness.savedSessions",
          "group": "navigation@1"
        },
        {
          "command": "multiHarness.openSettings",
          "when": "view == multiHarness.agents || view == multiHarness.cards",
          "group": "navigation"
        },
        {
          "command": "multiHarness.refreshSessions",
          "when": "view == multiHarness.savedSessions",
          "group": "navigation"
        },
        {
          "command": "multiHarness.selectSessionAgent",
          "when": "view == multiHarness.savedSessions",
          "group": "navigation@1"
        },
        {
          "command": "multiHarness.toggleSidebarLayout",
          "when": "view == multiHarness.agents || view == multiHarness.cards",
          "group": "navigation@1"
        },
        {
          "command": "multiHarness.toggleSessionSelectionMode",
          "when": "view == multiHarness.savedSessions && !multiHarness.sessionSelectionMode && multiHarness.sessionDeletionSupported",
          "group": "navigation@2"
        },
        {
          "command": "multiHarness.cancelSessionSelection",
          "when": "view == multiHarness.savedSessions && multiHarness.sessionSelectionMode",
          "group": "navigation@2"
        },
        {
          "command": "multiHarness.selectAllSessions",
          "when": "view == multiHarness.savedSessions && multiHarness.sessionSelectionMode",
          "group": "navigation@3"
        },
        {
          "command": "multiHarness.deleteSelectedSessions",
          "when": "view == multiHarness.savedSessions && multiHarness.sessionSelectionMode && multiHarness.hasSelectedSessions",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "multiHarness.openDeepseek",
          "group": "navigation@101",
          "when": "config.multiHarness.showDeepseekIcon"
        },
        {
          "command": "multiHarness.openOpenCode",
          "group": "navigation@102",
          "when": "config.multiHarness.showOpenCodeIcon"
        },
        {
          "command": "multiHarness.openClaudeCode",
          "group": "navigation@103",
          "when": "config.multiHarness.showClaudeCodeIcon"
        },
        {
          "command": "multiHarness.openCodex",
          "group": "navigation@104",
          "when": "config.multiHarness.showCodexIcon"
        },
        {
          "command": "multiHarness.openPi",
          "group": "navigation@105",
          "when": "config.multiHarness.showPiIcon"
        },
        {
          "command": "multiHarness.openGemini",
          "group": "navigation@106",
          "when": "config.multiHarness.showGeminiIcon"
        },
        {
          "command": "multiHarness.openGoose",
          "group": "navigation@107",
          "when": "config.multiHarness.showGooseIcon"
        },
        {
          "command": "multiHarness.openAider",
          "group": "navigation@108",
          "when": "config.multiHarness.showAiderIcon"
        },
        {
          "command": "multiHarness.openOhMyPi",
          "group": "navigation@109",
          "when": "config.multiHarness.showOhMyPiIcon"
        },
        {
          "command": "multiHarness.openCrush",
          "group": "navigation@110",
          "when": "config.multiHarness.showCrushIcon"
        },
        {
          "command": "multiHarness.openQwen",
          "group": "navigation@111",
          "when": "config.multiHarness.showQwenIcon"
        },
        {
          "command": "multiHarness.openPrimeAgent",
          "group": "navigation@112",
          "when": "config.multiHarness.showPrimeAgentIcon"
        },
        {
          "command": "multiHarness.openCopilot",
          "group": "navigation@113",
          "when": "config.multiHarness.showCopilotIcon"
        },
        {
          "command": "multiHarness.openAntigravity",
          "group": "navigation@114",
          "when": "config.multiHarness.showAntigravityIcon"
        },
        {
          "command": "multiHarness.openCursorAgent",
          "group": "navigation@115",
          "when": "config.multiHarness.showCursorAgentIcon"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "multiHarness.showDeepseekIcon": {
          "type": "boolean",
          "default": false,
          "description": "%showDeepseekIcon.description%",
          "scope": "window"
        },
        "multiHarness.showOpenCodeIcon": {
          "type": "boolean",
          "default": false,
          "description": "%showOpenCodeIcon.description%",
          "scope": "window"
        },
        "multiHarness.showClaudeCodeIcon": {
          "type": "boolean",
          "default": false,
          "description": "%showClaudeCodeIcon.description%",
          "scope": "window"
        },
        "multiHarness.showCodexIcon": {
          "type": "boolean",
          "default": false,
          "description": "%showCodexIcon.description%",
          "scope": "window"
        },
        "multiHarness.showPiIcon": {
          "type": "boolean",
          "default": false,
          "description": "%showPiIcon.description%",
          "scope": "window"
        },
        "multiHarness.showGeminiIcon": {
          "type": "boolean",
          "default": false,
          "description": "%showGeminiIcon.description%",
          "scope": "window"
        },
        "multiHarness.showGooseIcon": {
          "type": "boolean",
          "default": false,
          "description": "%showGooseIcon.description%",
          "scope": "window"
        },
        "multiHarness.showAiderIcon": {
          "type": "boolean",
          "default": false,
          "description": "%showAiderIcon.description%",
          "scope": "window"
        },
        "multiHarness.showOhMyPiIcon": {
          "type": "boolean",
          "default": false,
          "description": "%showOhMyPiIcon.description%",
          "scope": "window"
        },
        "multiHarness.showCrushIcon": {
          "type": "boolean",
          "default": false,
          "description": "%showCrushIcon.description%",
          "scope": "window"
        },
        "multiHarness.showQwenIcon": {
          "type": "boolean",
          "default": false,
          "description": "%showQwenIcon.description%",
          "scope": "window"
        },
        "multiHarness.showPrimeAgentIcon": {
          "type": "boolean",
          "default": false,
          "description": "%showPrimeAgentIcon.description%",
          "scope": "window"
        },
        "multiHarness.deepseek.executablePath": {
          "type": "string",
          "default": "dsh",
          "description": "%deepseek.executablePath.description%",
          "scope": "machine-overridable"
        },
        "multiHarness.openCode.executablePath": {
          "type": "string",
          "default": "opencode",
          "description": "%openCode.executablePath.description%",
          "scope": "machine-overridable"
        },
        "multiHarness.claudeCode.executablePath": {
          "type": "string",
          "default": "claude",
          "description": "%claudeCode.executablePath.description%",
          "scope": "machine-overridable"
        },
        "multiHarness.codex.executablePath": {
          "type": "string",
          "default": "codex",
          "description": "%codex.executablePath.description%",
          "scope": "machine-overridable"
        },
        "multiHarness.pi.executablePath": {
          "type": "string",
          "default": "pi",
          "description": "%pi.executablePath.description%",
          "scope": "machine-overridable"
        },
        "multiHarness.gemini.executablePath": {
          "type": "string",
          "default": "gemini",
          "description": "%gemini.executablePath.description%",
          "scope": "machine-overridable"
        },
        "multiHarness.goose.executablePath": {
          "type": "string",
          "default": "goose",
          "description": "%goose.executablePath.description%",
          "scope": "machine-overridable"
        },
        "multiHarness.aider.executablePath": {
          "type": "string",
          "default": "aider",
          "description": "%aider.executablePath.description%",
          "scope": "machine-overridable"
        },
        "multiHarness.ohMyPi.executablePath": {
          "type": "string",
          "default": "omp",
          "description": "%ohMyPi.executablePath.description%",
          "scope": "machine-overridable"
        },
        "multiHarness.crush.executablePath": {
          "type": "string",
          "default": "crush",
          "description": "%crush.executablePath.description%",
          "scope": "machine-overridable"
        },
        "multiHarness.qwen.executablePath": {
          "type": "string",
          "default": "qwen",
          "description": "%qwen.executablePath.description%",
          "scope": "machine-overridable"
        },
        "multiHarness.primeAgent.executablePath": {
          "type": "string",
          "default": "prime-agent",
          "description": "%primeAgent.executablePath.description%",
          "scope": "machine-overridable"
        },
        "multiHarness.deepseek.arguments": {
          "type": "array",
          "default": [
            "--profile",
            "tui"
          ],
          "items": {
            "type": "string"
          },
          "description": "%deepseek.arguments.description%",
          "scope": "resource"
        },
        "multiHarness.openCode.arguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%openCode.arguments.description%",
          "scope": "resource"
